{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "electron/main.cjs",
        "electron/bug-report/{review-ipc,review-preload,review-window-preload}.ts",
        "electron/external-navigation/{handler,preload}.ts",
        "electron/project/{dialog,lifecycle,preload}.ts",
        "electron/renderer/{document-marks,preload,runtime}.ts",
        "electron/text-services/{context-menu,ipc,system-fonts}.ts",
        "electron/updates/{ipc,preload}.ts",
        "electron/window/{appearance,lifecycle,preload}.ts",
        "electron/workspace/{preload,session}.ts",
        "electron/renderer/*smoke*.cjs",
        "electron/**/*.test.cjs",
        "server/index.ts",
        "server/native-diagnostics.ts",
        "mcp/server.ts",
        "server/**/*.test.ts",
        "shared/**/*.test.ts",
        "scripts/**/*.{mjs,cjs,ts}"
      ],
      "project": [
        "electron/**/*.{ts,cjs}",
        "server/**/*.ts",
        "mcp/**/*.ts",
        "shared/**/*.ts",
        "scripts/**/*.{mjs,cjs,ts}"
      ],
      "ignore": ["electron/*.d.cts"],
      "ignoreDependencies": ["opencode-ai", "electron-builder", "oxlint", "mammoth", "pdfjs-dist", "vite"]
    },
    "renderer": {
      "entry": [
        "src/bug-report.tsx",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.stories.tsx",
        "src/**/*.profile.tsx",
        ".storybook/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", ".storybook/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@storybook/addon-a11y", "@storybook/addon-docs", "shadcn"],
      "vite": true,
      "vitest": false,
      "storybook": false
    }
  }
}
