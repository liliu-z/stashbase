{
  "name": "@stashbase/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "storybook": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --output-dir ../dist/storybook",
    "format": "vp fmt src .storybook vite.config.ts --check",
    "lint": "vp lint --deny-warnings --config ../.oxlintrc.json src .storybook vite.config.ts",
    "test": "vp test run --exclude src/stories.a11y.test.tsx",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vp test run --coverage --exclude src/stories.a11y.test.tsx",
    "check:unused": "knip --no-progress",
    "check:dupes": "jscpd --config .jscpd.json src",
    "test:a11y": "vp test run src/stories.a11y.test.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons-static-svg": "1.95.0",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.1",
    "jsonc-parser": "^3.3.1",
    "katex": "0.16.47",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.6.0",
    "yaml": "^2.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "happy-dom": "20.11.2",
    "jscpd": "^5.2.0",
    "knip": "^6.34.0",
    "shadcn": "4.19.0",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  }
