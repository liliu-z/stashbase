{
  "name": "stashbase",
  "version": "2.0.0",
  "packageManager": "pnpm@11.5.1",
  "description": "Local-first knowledge base desktop app.",
  "author": {
    "name": "liliu-z",
    "email": "bingwuthu@gmail.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliu-z/stashbase.git"
  },
  "bugs": {
    "url": "https://github.com/liliu-z/stashbase/issues"
  },
  "homepage": "https://github.com/liliu-z/stashbase#readme",
  "keywords": [
    "knowledge-base",
    "local-first",
    "electron",
    "mcp",
    "milvus",
    "embeddings",
    "rag",
    "ai-index"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,srv -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config web-src/vite.config.ts",
    "dev:server": "STASHBASE_DEV_VITE=1 tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "mcp": "tsx mcp/server.ts",
    "build:web": "vite build --config web-src/vite.config.ts && node scripts/check-renderer-chunks.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:python-sidecar": "node scripts/build-python-sidecar.mjs",
    "build:python-extract-sidecar": "node scripts/build-python-sidecar.mjs --with-extract",
    "build:transcription-sidecar": "bash scripts/build-transcription-sidecar.sh",
    "clean:python-build": "node scripts/clean-python-build.mjs",
    "build": "pnpm build:web && pnpm build:server && pnpm build:mcp",
    "build:desktop": "pnpm build && pnpm build:python-sidecar && pnpm build:transcription-sidecar",
    "setup:python": "node scripts/setup-python.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:config": "node --import tsx --test server/app-config.test.ts server/embedding-availability.test.ts server/hosted-account.test.ts server/account-route.test.ts",
    "lint:web": "oxlint --config .oxlintrc.json web-src/src && node --test scripts/check-renderer-api-access.test.mjs && node scripts/check-renderer-api-access.mjs",
    "test:renderer": "node scripts/run-renderer-tests.mjs \"web-src/src/**/*.test.ts\"",
    "audit:renderer": "npx --yes @shadscan/cli@0.17.0 . --json --no-interactive --fail-under 45",
    "test:renderer-quality-gates": "node --test scripts/renderer-quality-gates.test.mjs",
    "test:electron": "node --test --test-reporter=spec electron/multi-window.test.cjs electron/clipboard-watch-policy.test.cjs electron/bug-report-service.test.cjs electron/bug-report-redaction.test.cjs electron/bug-report-collection.test.cjs electron/bug-report-handoff.test.cjs electron/bug-report-review.test.cjs",
    "test:electron:smoke": "node electron/multi-window-smoke-runner.cjs",
    "test:e2e:harness": "node --import tsx --test e2e/support/fixtures.test.ts && node --test e2e/support/ci-summary-reporter.test.cjs && playwright test e2e/harness --project=electron-smoke",
    "test:e2e:check-focus": "node --test scripts/check-e2e-focus.test.mjs && node scripts/check-e2e-focus.mjs e2e",
    "test:e2e:smoke": "playwright test e2e/smoke --project=electron-smoke",
    "test:e2e:agent-protocol": "node --test e2e/fixtures/fake-codex-app-server.test.mjs",
    "test:e2e:functional": "pnpm test:e2e:agent-protocol && playwright test --project=electron-functional",
    "test:e2e:visual": "playwright test --project=electron-visual-linux",
    "test:e2e:visual:update": "playwright test --project=electron-visual-linux --update-snapshots",
    "test:e2e:debug": "playwright test e2e/smoke --project=electron-smoke --debug",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:renderer-chunks": "node scripts/check-renderer-chunks.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:inventory": "node scripts/check-test-inventory.mjs",
    "test:conversion-scheduler": "node --import tsx --test server/html.test.ts server/filesystem-path.test.ts server/folder-relative-path.test.ts server/folder-window.test.ts server/window-context-route.test.ts server/internal-shutdown-route.test.ts server/files.test.ts server/file-formats.test.ts server/file-hash.test.ts server/http.test.ts server/markdown-source-format.test.ts server/keyword-search.test.ts server/index-status.test.ts server/indexer-mfs-path.test.ts server/semantic-workload.test.ts server/session-path.test.ts server/conversion-scheduler.test.ts server/conversion-auxiliary.test.ts server/conversion-status.test.ts server/conversion.test.ts server/extractor-process.test.ts server/audio-transcription.test.ts server/transcription-models.test.ts server/transcription-provider.test.ts server/transcription-runtime.test.ts server/transcription-tools.test.ts server/upload.test.ts server/client-error.test.ts server/semantic-indexing-state.test.ts",
    "test:library-files": "node --import tsx --test server/library-file-mutations.test.ts server/library-operations/index.test.ts server/routes/library-files.test.ts server/routes/attach.test.ts server/__tests__/file-listing.test.ts",
    "test:retrieval": "node --import tsx --test server/retrieval/index.test.ts",
    "test:agent": "node --import tsx --test server/__tests__/agent.test.ts server/__tests__/agent-contract.test.ts server/__tests__/agent-history-routes.test.ts server/__tests__/agent-projects.test.ts server/__tests__/agent-runtime-installer.test.ts server/__tests__/agent-turn-failure.test.ts server/__tests__/codex-agent.test.ts server/__tests__/agent-cli.test.ts server/codex-history.test.ts",
    "test:agent:native": "node --import tsx --test server/__tests__/agent-native-smoke.test.ts",
    "test:mcp": "node --import tsx --test server/__tests__/mcp-http-settings.test.ts server/__tests__/mcp-http-service.test.ts server/__tests__/mcp-http-transport.test.ts server/__tests__/shutdown-cleanup.test.ts",
    "test:release-gate": "node --test scripts/require-green-ci.test.mjs",
    "test:package-inputs": "node --test scripts/package-inputs.test.mjs",
    "test:macos-signing": "node --test scripts/macos-release-contract.test.mjs",
    "test:windows-signing": "node --test scripts/windows-release-contract.test.mjs",
    "test:updates": "node --test electron/update-manager.test.cjs electron/update-install-strategy.test.cjs electron/update-window-barrier.test.cjs scripts/github-release-api.test.mjs scripts/update-release-contract.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web-src/tsconfig.json && pnpm typecheck:e2e",
    "check": "pnpm test:docs && pnpm test:inventory && pnpm test:python && pnpm test:release-gate && pnpm test:package-inputs && pnpm test:macos-signing && pnpm test:windows-signing && pnpm test:updates && pnpm test:config && pnpm test:renderer && npm run test:electron && pnpm test:conversion-scheduler && pnpm test:library-files && pnpm test:retrieval && pnpm test:agent && pnpm test:mcp && pnpm typecheck && pnpm build && pnpm test:electron:smoke",
    "prestart": "pnpm build:web",
    "electron": "electron .",
    "package:mac": "node scripts/package-desktop.mjs",
    "package:mac:dir": "node scripts/package-desktop.mjs --dir",
    "package:win": "node scripts/package-desktop.mjs --win",
    "package:linux": "node scripts/package-desktop.mjs --linux",
    "dist": "pnpm package:mac",
    "dist:all": "pnpm package:mac && pnpm package:win && pnpm package:linux",
    "dist:brew": "node scripts/publish.mjs",
    "smoke:packaged-server": "node scripts/smoke-packaged-server.mjs",
    "release:verify:mac": "node scripts/release-verify-mac.mjs",
    "pack:mac": "pnpm package:mac:dir",
    "dist:mac": "pnpm package:mac",
    "dist:win": "pnpm package:win",
    "dist:linux": "pnpm package:linux"
  },
  "build": {
    "appId": "com.stashbase.app",
    "productName": "StashBase",
    "protocols": [
      {
        "name": "StashBase OAuth Return",
        "schemes": [
          "stashbase"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon",
    "afterPack": "scripts/after-pack-macos.cjs",
    "directories": {
      "output": "release.nosync"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "liliu-z",
        "repo": "stashbase"
      }
    ],
    "files": [
      "package.json",
      "electron/**/*",
      "shared/**/*",
      "dist/server/**",
      "dist/mcp/**",
      "web/dist-app/**/*",
      "node_modules/**/*",
      "!dist/pyinstaller/**"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "stashbase_daemon.py",
          "pdf_extract.py",
          "ocr_extract.py",
          "requirements.txt",
          "runtime/**/*"
        ]
      },
      {
        "from": "python/sidecar.nosync",
        "to": "python/sidecar"
      },
      {
        "from": "native/transcription/sidecar.nosync",
        "to": "transcription"
      },
      {
        "from": "assets/builtin-library",
        "to": "assets/builtin-library"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@vscode/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk*/**/*",
      "node_modules/.pnpm/better-sqlite3*/**/*",
      "node_modules/.pnpm/@vscode+ripgrep*/**/*",
      "node_modules/.pnpm/@anthropic-ai+claude-agent-sdk*/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "sign": false,
      "title": "StashBase",
      "contents": [
        {
          "x": 120,
          "y": 220,
          "type": "file"
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Office",
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icons"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libnss3",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libgdk-pixbuf-2.0-0 | libgdk-pixbuf2.0-0",
        "libgtk-3-0",
        "libx11-xcb1",
        "libxcb-dri3-0",
        "libxtst6",
        "libasound2 | libasound2t64"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.161",
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@noble/hashes": "^2.2.0",
    "@vscode/ripgrep": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "motion": "^12.43.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.20.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^39.8.8",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.11.2",
    "http-proxy-middleware": "^4.0.0",
    "oxlint": "^1.78.0",
    "playwright": "1.62.1",
    "react-test-renderer": "19.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.12"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  }
}
